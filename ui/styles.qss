QMainWindow, QWidget {
    background: #1a1c23;
    color: #e0e0e0;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}

QToolBar {
    background: #252830;
    border-bottom: 1px solid #2e3140;
    padding: 6px 12px;
    spacing: 6px;
}

QToolBar QToolButton {
    background: transparent;
    color: #aaa;
    border: none;
    padding: 5px 10px;
    border-radius: 6px;
}

QToolBar QToolButton:hover {
    background: #2e3140;
    color: #fff;
}

/* Naslovna traka */
QLabel#appTitle {
    font-size: 16px;
    font-weight: 500;
    color: #ffffff;
    background: transparent;
}

QLabel#appSubtitle {
    font-size: 12px;
    color: #888;
    background: transparent;
}

/* Zona za fajl — dragActive mora biti poslednji da nadjača state-ove */
QFrame#fileZone {
    border: 1.5px dashed #3a3e52;
    border-radius: 10px;
    background: #1e2130;
}

QFrame#fileZone[state="empty"]:hover {
    border-color: #4a5080;
    background: #22263a;
}

QFrame#fileZone[state="loading"] {
    border: 1px solid #3a4a6a;
    background: #1e2436;
}

QFrame#fileZone[state="loaded"] {
    border: 1.5px dashed #3a3e52;
    background: #1e2130;
}

QFrame#fileZone[state="loaded"]:hover {
    border-color: #4a5080;
    background: #22263a;
}

QFrame#fileZone[dragActive="true"] {
    border: 1.5px dashed #4a7adf;
    background: #253055;
}

/* Dugme za izbor drugog fajla, unutar zone */
QPushButton#btnPickAnother {
    background: #2e3140;
    border: 1px solid #3a3e52;
    border-radius: 5px;
    color: #cfd3dd;
    font-size: 11px;
    padding: 0 9px;
}

QPushButton#btnPickAnother:hover {
    background: #3a3f55;
    color: #fff;
}

/* Sekcije */
QLabel#sectionLabel {
    font-size: 10px;
    font-weight: 500;
    color: #555;
    letter-spacing: 1.5px;
    background: transparent;
}

QLabel#sectionLabel:disabled {
    color: #3a3d47;
}

/* Sekcija optimizacije — sve ima :disabled varijantu */
QLabel#optLabel {
    font-size: 13px;
    font-weight: 500;
    color: #e0e0e0;
    background: transparent;
}

QLabel#optLabel:disabled {
    color: #55596a;
}

QLabel#ratioPill {
    font-size: 13px;
    font-weight: 500;
    color: #fff;
    background: #2e3140;
    border-radius: 12px;
    padding: 2px 8px;
}

QLabel#ratioPill:disabled {
    color: #6b7280;
    background: #24262f;
}

QLabel#optHint {
    font-size: 11px;
    color: #555;
    background: transparent;
}

QLabel#optHint:disabled {
    color: #3a3d47;
}

/* Slider */
QSlider::groove:horizontal {
    background: #2e3140;
    height: 4px;
    border-radius: 2px;
}

QSlider::groove:horizontal:disabled {
    background: #24262f;
}

QSlider::handle:horizontal {
    background: #ffffff;
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border-radius: 9px;
    border: 2px solid #3a3e52;
}

QSlider::handle:horizontal:hover {
    background: #e0e0e0;
}

QSlider::handle:horizontal:disabled {
    background: #3a3d47;
    border-color: #2e3140;
}

QSlider::sub-page:horizontal {
    background: #4a5a8a;
    border-radius: 2px;
}

QSlider::sub-page:horizontal:disabled {
    background: #2e3140;
}

/* Radio */
QRadioButton {
    spacing: 8px;
    color: #ccc;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #3a3e52;
    background: transparent;
}

QRadioButton::indicator:checked {
    background: #4a7adf;
    border-color: #4a7adf;
}

QRadioButton:disabled {
    color: #55596a;
}

QRadioButton::indicator:disabled {
    border-color: #2e3140;
}

QRadioButton::indicator:checked:disabled {
    background: #33405c;
    border-color: #33405c;
}

/* Dugmad */
QPushButton {
    background: #252830;
    color: #ccc;
    border: 1px solid #3a3e52;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background: #2e3140;
    color: #fff;
    border-color: #4a5080;
}

QPushButton:pressed {
    background: #1e2130;
}

QPushButton:disabled {
    color: #444;
    border-color: #2e3140;
    background: #1e2130;
}

/* .max kontrole — podnožje unutar zone za fajl */
QPushButton#btnLoadMax {
    background: #1e2a1e;
    color: #7ec87e;
    border: 1px solid #2e4a2e;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 500;
    padding: 0 8px;
}

QPushButton#btnLoadMax:hover {
    background: #253525;
    color: #a0e0a0;
}

QPushButton#btnLoadMax:disabled {
    background: #1c211c;
    color: #3d5c3d;
    border-color: #253525;
}

QLabel#maxPathHint {
    color: #6b7280;
    font-size: 10px;
    background: transparent;
}

QLabel#maxPathHint:hover {
    color: #8b93a3;
}

QPushButton#btnConvert {
    background: #252830;
    color: #e0e0e0;
    border: 1px solid #3a3e52;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    padding: 10px;
}

QPushButton#btnConvert:hover {
    background: #2e3140;
}

QPushButton#btnConvert:disabled {
    color: #444;
}

QPushButton#btnAscii {
    background: #252830;
    color: #ccc;
    border: 1px solid #3a3e52;
    border-radius: 8px;
    font-size: 13px;
    padding: 8px;
}

QPushButton#btnObj {
    background: #252830;
    color: #ccc;
    border: 1px solid #3a3e52;
    border-radius: 8px;
    font-size: 13px;
    padding: 8px;
}

/* Status bar */
QStatusBar {
    background: #252830;
    color: #666;
    border-top: 1px solid #2e3140;
    font-size: 12px;
    padding: 3px 10px;
}

/* Separator */
QFrame[frameShape="4"] {
    color: #2e3140;
    background: #2e3140;
    border: none;
    max-height: 1px;
}

/* Scrollbar */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
}
QScrollBar::handle:vertical {
    background: #3a3e52;
    border-radius: 3px;
}
